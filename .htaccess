RewriteEngine On

# Set proper content type for XML files (including sitemap)
<Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=utf-8"
</Files>

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.salonraia\.eu [NC]
RewriteRule ^(.*)$ https://salonraia.eu/$1 [L,R=301]

# Original rules
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php